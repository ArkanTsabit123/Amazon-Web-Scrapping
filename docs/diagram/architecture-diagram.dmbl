// =============================================
// AMAZON SCRAPING - DATA WAREHOUSE SCHEMA
// BASED ON ACTUAL SCRAPING OUTPUT
// USING https://dbdiagram.io/
// =============================================

// ---------------------------------------------
// 1. product_dim (Product Dimension)
// ---------------------------------------------
Table product_dim {
  product_id integer [pk, increment]
  title varchar [note: 'Product name from #productTitle']
  product_url varchar [unique]
  search_keyword varchar [note: 'Keyword used in search']
}

// ---------------------------------------------
// 2. price_dim (Price Dimension)
// ---------------------------------------------
Table price_dim {
  price_id integer [pk, increment]
  price_string varchar [note: 'Raw price with $, e.g., $37.99']
  price_amount float [note: 'Numeric price, e.g., 37.99']
  currency varchar [default: 'USD']
}

// ---------------------------------------------
// 3. rating_dim (Rating Dimension)
// ---------------------------------------------
Table rating_dim {
  rating_id integer [pk, increment]
  rating_string varchar [note: 'e.g., 4.8 out of 5 stars']
  rating_stars float [note: 'Numeric rating, e.g., 4.8']
}

// ---------------------------------------------
// 4. reviews_dim (Reviews Dimension)
// ---------------------------------------------
Table reviews_dim {
  reviews_id integer [pk, increment]
  reviews_string varchar [note: 'e.g., 8 ratings']
  review_count integer [note: 'Numeric count, e.g., 8']
}

// ---------------------------------------------
// 5. availability_dim (Availability Dimension)
// ---------------------------------------------
Table availability_dim {
  availability_id integer [pk, increment]
  status_string varchar [note: 'e.g., In Stock, Not Available']
  status_code varchar [note: 'IN_STOCK, OUT_OF_STOCK, UNKNOWN']
}

// ---------------------------------------------
// 6. scrape_date_dim (Scrape Date Dimension)
// ---------------------------------------------
Table scrape_date_dim {
  date_id integer [pk, increment]
  scrape_date date
  scrape_timestamp timestamp [note: 'Full timestamp']
  scrape_year integer
  scrape_month integer
  scrape_day integer
  scrape_weekday varchar [note: 'Monday-Sunday']
  scrape_hour integer [note: '0-23']
}

// ---------------------------------------------
// 7. fact_amazon_scraping (Fact Table)
// ---------------------------------------------
Table fact_amazon_scraping {
  fact_id integer [pk, increment]
  product_id integer [not null]
  price_id integer [not null]
  rating_id integer [not null]
  reviews_id integer [not null]
  availability_id integer [not null]
  date_id integer [not null]
  search_keyword varchar [note: 'Keyword used in search']
  rank_position integer [note: 'Position in search results']
}

// =============================================
// RELATIONSHIPS - ALL CONNECTED
// =============================================

Ref: fact_amazon_scraping.product_id > product_dim.product_id
Ref: fact_amazon_scraping.price_id > price_dim.price_id
Ref: fact_amazon_scraping.rating_id > rating_dim.rating_id
Ref: fact_amazon_scraping.reviews_id > reviews_dim.reviews_id
Ref: fact_amazon_scraping.availability_id > availability_dim.availability_id
Ref: fact_amazon_scraping.date_id > scrape_date_dim.date_id

